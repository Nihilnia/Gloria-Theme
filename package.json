{
	"name": "gloria-theme",
	"displayName": "プロジェクト_Gloria",
	"description": "Temet Nosce",
	"version": "1.0.6",
	"icon": "nihilZone.jpg",
	"author": "Nihil",
	"publisher": "Nihil",
	"engines": {
		"vscode": "^1.60.0"
	},
	"scripts": {
		"test": "node ./test/htmlGrandparents.test.js && node ./test/cssBraces.test.js"
	},
	"extensionKind": [
		"ui"
	],
	"categories": [
		"Themes"
	],
	"activationEvents": [
		"onStartupFinished",
		"onLanguage:html",
		"onLanguage:css"
	],
	"main": "./src/extension.js",
	"contributes": {
		"themes": [
			{
				"label": "Gloria",
				"uiTheme": "vs-dark",
				"path": "./themes/gloria-color-theme.json"
			}
		],
		"commands": [],
		"configuration": {
			"title": "Gloria",
			"properties": {
				"gloria.brightness": {
					"type": "number",
					"default": 0.45,
					"description": "Set the brightness value for the glow effect. 0.0 is fully transparent and 1.0 is fully bright"
				},
				"gloria.disableGlow": {
					"type": "boolean",
					"default": false,
					"description": "Disable the glow effect, but show editor chrome updates"
				}
			}
		}
	}
}
